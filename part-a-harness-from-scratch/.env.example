# Copy to .env in this directory (or at the repository root) and fill in one key.
# .env is gitignored; .env.example never holds a real key.
#
# Pick ONE route and set HARNESS_MODEL to an id that route understands.

# ---- route 1, the default: everything through OpenRouter -----------------
# This is what the assignment targets: one key for many models, usage.cost in
# every response, and server-side model fallback (step 15).
#
# Both model ids below are FREE-TIER (":free"), so a fresh clone plus a key runs
# the whole course at zero cost. The free tier is rate limited - roughly 50
# requests a day per account, shared across every model - so for real work swap
# in a paid id and change nothing else:
#   HARNESS_MODEL=google/gemini-3.5-flash     (fast, cheap, strong tool use)
#   HARNESS_MODEL=deepseek/deepseek-v4-flash  (cheapest paid option)
#   HARNESS_MODEL=anthropic/claude-sonnet-5   (best at long agentic turns)
OPENROUTER_API_KEY=sk-or-v1-replace-me
HARNESS_MODEL=deepseek/deepseek-v4-flash-0731:free
HARNESS_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free

# ---- route 2: an OpenAI key, straight to OpenAI --------------------------
# Same harness, same code path. OpenAI reports tokens but no cost, and the
# fallback chain and provider preferences are OpenRouter extensions, so step 15
# sends neither and /cost prints "n/a" instead of a made-up number.
# HARNESS_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-replace-me
# HARNESS_MODEL=gpt-5-mini             # gpt-4.1-mini also does tool calling

# ---- route 3: a student Gemini key, straight to Google -------------------
# Or bring the Gemini key to OpenRouter as BYOK and stay on route 1.
# HARNESS_PROVIDER=gemini
# GEMINI_API_KEY=AIza-replace-me
# HARNESS_MODEL=gemini-3.5-flash

# ---- optional ------------------------------------------------------------
# HARNESS_BASE_URL=https://openrouter.ai/api/v1   # overrides whichever route you picked
# HARNESS_PROVIDER_SORT=price          # price | throughput | latency (OpenRouter, step 15)
# HARNESS_PROVIDER_ORDER=google-vertex,google-ai-studio
# HARNESS_CONTEXT_WINDOW=128000        # compaction budget (step 13)
