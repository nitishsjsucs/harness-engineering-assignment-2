# Copy to .env (never commit the real file) -- only needed for `arh loop`.
# The engine, the tasks and the offline tests need none of this.

# Which endpoint proposes experiments: openrouter (default) | openai | gemini.
HARNESS_PROVIDER=openrouter

# --- openrouter (default) ---------------------------------------------------
OPENROUTER_API_KEY=sk-or-your-key-here
# The default model is a ":free" one, so the whole harness can be run end to
# end at zero cost. OpenRouter's free tier is a shared DAILY quota (about 50
# requests), and one experiment costs at least one request -- cap a loop with
# `arh loop --max-requests N`.
HARNESS_MODEL=deepseek/deepseek-v4-flash-0731:free
# Swap to a paid model in one line when you want better proposals:
# HARNESS_MODEL=anthropic/claude-sonnet-5
# Server-side fallback if the first choice is unavailable (comma separated).
# Careful: a paid fallback behind a free primary is a paid run.
# HARNESS_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free

# --- openai -----------------------------------------------------------------
# HARNESS_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-your-key-here
# HARNESS_MODEL=gpt-5-mini          # gpt-4.1-mini also does tool calling

# --- gemini (Google AI Studio's OpenAI-compatible endpoint) ------------------
# HARNESS_PROVIDER=gemini
# GEMINI_API_KEY=your-google-ai-studio-key
# HARNESS_MODEL=gemini-3.5-flash

# Override the endpoint for any provider (a proxy, a local gateway, ...).
# HARNESS_BASE_URL=https://openrouter.ai/api/v1
